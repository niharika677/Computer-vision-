import cv2
import numpy as np

cap = cv2.VideoCapture("sample.mp4")

width = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))
height = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))
fps = cap.get(cv2.CAP_PROP_FPS)

out = cv2.VideoWriter("perspective_video.mp4",
                      cv2.VideoWriter_fourcc(*'mp4v'),
                      fps,
                      (width, height))

while True:

    ret, frame = cap.read()

    if not ret:
        break

    pts1 = np.float32([[50,50],[500,50],[50,400],[500,400]])
    pts2 = np.float32([[20,100],[500,50],[100,400],[500,350]])

    M = cv2.getPerspectiveTransform(pts1, pts2)

    result = cv2.warpPerspective(frame, M, (width, height))

    out.write(result)

    cv2.imshow("Perspective Video", result)

    if cv2.waitKey(20) & 0xFF == ord('q'):
        break

cap.release()
out.release()
cv2.destroyAllWindows()
