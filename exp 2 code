import cv2

img = cv2.imread("image.jpg")

if img is None:
    print("Image not found")
    exit()

# Apply Gaussian Blur
blur = cv2.GaussianBlur(img, (15, 15), 0)

cv2.imwrite("blur_image.jpg", blur)

cv2.imshow("Original Image", img)
cv2.imshow("Blur Image", blur)

cv2.waitKey(0)
cv2.destroyAllWindows()
