import cv2
import numpy as np

img = cv2.imread("image.jpg")

if img is None:
    print("Image not found")
    exit()

rows, cols = img.shape[:2]

src = np.float32([[50,50],[300,50],[50,300],[300,300]])
dst = np.float32([[30,100],[320,60],[80,320],[320,280]])

# DLT is internally used by OpenCV to compute homography
H = cv2.getPerspectiveTransform(src, dst)

result = cv2.warpPerspective(img, H, (cols, rows))

cv2.imwrite("dlt_output.jpg", result)

cv2.imshow("Original", img)
cv2.imshow("DLT Transformation", result)

cv2.waitKey(0)
cv2.destroyAllWindows()
